diff --git a/css/base.css b/css/base.css
index 9c8faff..9032154 100644
--- a/css/base.css
+++ b/css/base.css
@@ -1161,3 +1161,36 @@ body[data-pagina="inicio"] .portada.foto::after {
   margin: 0;
   opacity: 0.85;
 }
+
+/* =========================================================
+   Botón "Instalar app" y su ayuda
+   ========================================================= */
+.instalar-fila { display: flex; justify-content: center; margin-top: 14px; }
+.instalar-fila--portada { justify-content: center; margin: 20px 0 4px; }
+.instalar-btn {
+  display: inline-flex; align-items: center; gap: 9px;
+  padding: 10px 20px; border: 2px solid var(--accent-cta); border-radius: 999px;
+  background: var(--brand-mineral); color: var(--accent-cta);
+  font-family: var(--letra-texto); font-size: 14px; font-weight: 700; letter-spacing: .02em;
+  cursor: pointer; transition: background .15s, color .15s, transform .15s, box-shadow .15s;
+  box-shadow: 0 6px 18px -8px rgba(24, 32, 38, .55);
+}
+.instalar-btn svg { width: 17px; height: 17px; flex: none; }
+.instalar-btn:hover, .instalar-btn:focus-visible { background: var(--accent-cta); color: var(--text-primary); transform: translateY(-1px); }
+.instalar-btn:focus-visible { outline: 3px solid var(--brand-mineral); outline-offset: 3px; }
+
+.instalar-dialogo {
+  width: min(92vw, 420px); padding: 22px 24px; border: 2px solid var(--accent-cta); border-radius: 14px;
+  background: var(--text-primary); color: #eef1ee;
+  box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .7);
+}
+.instalar-dialogo::backdrop { background: rgba(24, 32, 38, .75); backdrop-filter: blur(3px); }
+.instalar-dialogo__etiqueta { margin: 0 0 6px; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-cta); }
+.instalar-dialogo__titulo { margin: 0 0 12px; font-family: var(--letra-universidad); font-size: 22px; color: #fff; }
+.instalar-dialogo__pasos { margin: 0 0 16px; padding-left: 22px; display: grid; gap: 8px; font-size: 15px; line-height: 1.5; }
+.instalar-dialogo__pasos b { color: #fff; }
+.instalar-dialogo__cerrar {
+  width: 100%; padding: 11px; border: 2px solid var(--accent-cta); border-radius: 999px; background: transparent;
+  color: var(--accent-cta); font-family: var(--letra-texto); font-size: 14px; font-weight: 700; cursor: pointer;
+}
+.instalar-dialogo__cerrar:hover, .instalar-dialogo__cerrar:focus-visible { background: var(--accent-cta); color: var(--text-primary); }
